## 7\. Estratégia de Testes Automatizados

### Teste Unitário dos Vetores SigLIP (`backend/tests/test_embeddings.py`)

import numpy as np

import pytest

from PIL import Image

from app.services.siglip\_service import SigLIPService

@pytest.fixture(scope="module")

def siglip():

    return SigLIPService()

def test\_text\_embedding\_dimensions\_and\_norm(siglip):

    vec \= siglip.embed\_text("sapato de couro marrom clássico")

    assert vec.shape \== (768,)

    \# Verifica se a normalização L2 resultou em magnitude unitária (1.0)

    norm \= np.linalg.norm(vec)

    assert np.isclose(norm, 1.0, atol=1e-4)

def test\_image\_embedding\_dimensions\_and\_norm(siglip):

    \# Cria uma imagem sintética RGB de 384x384

    img \= Image.new("RGB", (384, 384), color="blue")

    vec \= siglip.embed\_image(img)

    assert vec.shape \== (768,)

    norm \= np.linalg.norm(vec)

    assert np.isclose(norm, 1.0, atol=1e-4)

def test\_semantic\_alignment\_cross\_modal(siglip):

    \# Uma imagem azul pura deve ter maior similaridade de cosseno com a palavra "blue" do que com "red"

    img \= Image.new("RGB", (384, 384), color="blue")

    img\_vec \= siglip.embed\_image(img)

    text\_blue \= siglip.embed\_text("vibrant blue background")

    text\_red \= siglip.embed\_text("bright red tomato")

    sim\_blue \= np.dot(img\_vec, text\_blue)

    sim\_red \= np.dot(img\_vec, text\_red)

    assert sim\_blue \> sim\_red

