CREATE TABLE IF NOT EXISTS catalog\_items (

    id UUID PRIMARY KEY DEFAULT gen\_random\_uuid(),

    title VARCHAR(200) NOT NULL,

    description TEXT NOT NULL,

    price NUMERIC(10, 2\) NOT NULL,

    category\_id INTEGER REFERENCES categories(id) ON DELETE SET NULL,

    image\_url TEXT NOT NULL,

    thumbnail\_url TEXT,

    \-- Vetor de 768 dimensões gerado pelo SigLIP-base

    embedding vector(768) NOT NULL,

    metadata JSONB NOT NULL DEFAULT '{}',

    is\_active BOOLEAN NOT NULL DEFAULT TRUE,

    created\_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    updated\_at TIMESTAMPTZ NOT NULL DEFAULT NOW()

);

\-- Índice HNSW para busca vetorial de altíssima performance por similaridade de cosseno

CREATE INDEX IF NOT EXISTS idx\_catalog\_items\_embedding\_hnsw 

ON catalog\_items USING hnsw (embedding vector\_cosine\_ops)

WITH (m \= 16, ef\_construction \= 64);

