## 5\. Implementação Passo a Passo com Código-Fonte Chave

### 5.1 Motor SigLIP de Inferência (`backend/app/services/siglip_service.py`)

import io

import torch

import numpy as np

from PIL import Image

from transformers import AutoProcessor, AutoModel

from typing import List, Union

class SigLIPService:

    def \_\_init\_\_(self, model\_name: str \= "google/siglip-base-patch16-384"):

        self.device \= "cuda" if torch.cuda.is\_available() else ("mps" if torch.backends.mps.is\_available() else "cpu")

        self.processor \= AutoProcessor.from\_pretrained(model\_name)

        \# Carrega o modelo com meia precisão em GPU para máxima velocidade

        dtype \= torch.float16 if self.device \!= "cpu" else torch.float32

        self.model \= AutoModel.from\_pretrained(model\_name, torch\_dtype=dtype).to(self.device)

        self.model.eval()

    def embed\_text(self, text: str) \-\> np.ndarray:

        """Gera embedding normalizado L2 de 768 dimensões para uma string de consulta."""

        inputs \= self.processor(text=\[text\], return\_tensors="pt", padding=True).to(self.device)

        with torch.no\_grad():

            text\_features \= self.model.get\_text\_features(\*\*inputs)

            \# Normalização L2 obrigatória para cálculo de similaridade de cosseno

            text\_features \= text\_features / text\_features.norm(p=2, dim=-1, keepdim=True)

            return text\_features.cpu().numpy()\[0\].astype(np.float32)

    def embed\_image(self, image\_input: Union\[bytes, Image.Image\]) \-\> np.ndarray:

        """Gera embedding normalizado L2 de 768 dimensões para uma imagem (bytes ou PIL Image)."""

        if isinstance(image\_input, bytes):

            image \= Image.open(io.BytesIO(image\_input)).convert("RGB")

        else:

            image \= image\_input.convert("RGB")

        inputs \= self.processor(images=\[image\], return\_tensors="pt").to(self.device)

        with torch.no\_grad():

            image\_features \= self.model.get\_image\_features(\*\*inputs)

            image\_features \= image\_features / image\_features.norm(p=2, dim=-1, keepdim=True)

            return image\_features.cpu().numpy()\[0\].astype(np.float32)

### 5.2 Serviço de Busca Vetorial com `pgvector` (`backend/app/services/search_service.py`)

import time

import numpy as np

from typing import List, Optional

from sqlalchemy.ext.asyncio import AsyncSession

from sqlalchemy import select, and\_

from app.models.catalog import CatalogItem

from app.schemas.item\_schemas import ItemResponse, SearchResponse

class SearchService:

    def \_\_init\_\_(self, session: AsyncSession):

        self.session \= session

    async def search\_by\_vector(

        self,

        query\_vector: np.ndarray,

        top\_k: int \= 12,

        min\_score: float \= 0.20,

        category\_id: Optional\[int\] \= None,

        min\_price: Optional\[float\] \= None,

        max\_price: Optional\[float\] \= None,

        search\_type: str \= "TEXT",

        query\_display: str \= ""

    ) \-\> SearchResponse:

        start\_time \= time.perf\_counter()

        \# No pgvector com métrica de cosseno:

        \# cosine\_distance \= 1 \- cosine\_similarity

        \# logo, cosine\_similarity \= 1 \- (embedding \<=\> query\_vector)

        similarity\_expr \= (1 \- CatalogItem.embedding.cosine\_distance(query\_vector.tolist())).label("similarity")

        conditions \= \[CatalogItem.is\_active \== True\]

        if category\_id:

            conditions.append(CatalogItem.category\_id \== category\_id)

        if min\_price is not None:

            conditions.append(CatalogItem.price \>= min\_price)

        if max\_price is not None:

            conditions.append(CatalogItem.price \<= max\_price)

        stmt \= (

            select(CatalogItem, similarity\_expr)

            .where(and\_(\*conditions))

            .order\_by(CatalogItem.embedding.cosine\_distance(query\_vector.tolist()))

            .limit(top\_k)

        )

        result \= await self.session.execute(stmt)

        rows \= result.all()

        items \= \[\]

        for item, sim in rows:

            sim\_float \= float(sim)

            if sim\_float \>= min\_score:

                item\_dict \= {

                    "id": item.id,

                    "title": item.title,

                    "description": item.description,

                    "price": float(item.price),

                    "category\_id": item.category\_id,

                    "image\_url": item.image\_url,

                    "thumbnail\_url": item.thumbnail\_url,

                    "similarity\_score": round(sim\_float, 4),

                    "created\_at": item.created\_at

                }

                items.append(ItemResponse(\*\*item\_dict))

        elapsed\_ms \= (time.perf\_counter() \- start\_time) \* 1000

        return SearchResponse(

            search\_type=search\_type,

            query\_display=query\_display,

            total\_results=len(items),

            execution\_time\_ms=round(elapsed\_ms, 2),

            items=items

        )

### 5.3 Rotas FastAPI (`backend/app/routers/search.py`)

from fastapi import APIRouter, Depends, UploadFile, File, Form, HTTPException

from sqlalchemy.ext.asyncio import AsyncSession

from app.database import get\_db

from app.services.siglip\_service import SigLIPService

from app.services.search\_service import SearchService

from app.schemas.item\_schemas import TextSearchRequest, SearchResponse

from typing import Optional

router \= APIRouter(prefix="/api/v1/search", tags=\["Search"\])

\# Instância única do modelo em memória compartilhada

siglip\_singleton \= SigLIPService()

def get\_siglip():

    return siglip\_singleton

@router.post("/text", response\_model=SearchResponse)

async def search\_by\_text(

    payload: TextSearchRequest,

    db: AsyncSession \= Depends(get\_db),

    siglip: SigLIPService \= Depends(get\_siglip)

):

    query\_vector \= siglip.embed\_text(payload.query)

    search\_service \= SearchService(db)

    return await search\_service.search\_by\_vector(

        query\_vector=query\_vector,

        top\_k=payload.top\_k,

        min\_score=payload.min\_score,

        category\_id=payload.category\_id,

        min\_price=payload.min\_price,

        max\_price=payload.max\_price,

        search\_type="TEXT",

        query\_display=payload.query

    )

@router.post("/image", response\_model=SearchResponse)

async def search\_by\_image(

    file: UploadFile \= File(...),

    top\_k: int \= Form(12),

    min\_score: float \= Form(0.20),

    category\_id: Optional\[int\] \= Form(None),

    min\_price: Optional\[float\] \= Form(None),

    max\_price: Optional\[float\] \= Form(None),

    db: AsyncSession \= Depends(get\_db),

    siglip: SigLIPService \= Depends(get\_siglip)

):

    if not file.content\_type.startswith("image/"):

        raise HTTPException(status\_code=400, detail="O arquivo enviado deve ser uma imagem válida.")

    image\_bytes \= await file.read()

    query\_vector \= siglip.embed\_image(image\_bytes)

    search\_service \= SearchService(db)

    return await search\_service.search\_by\_vector(

        query\_vector=query\_vector,

        top\_k=top\_k,

        min\_score=min\_score,

        category\_id=category\_id,

        min\_price=min\_price,

        max\_price=max\_price,

        search\_type="IMAGE",

        query\_display=file.filename

    )

