# Banco de dados (SQLite por padrão para desenvolvimento local rápido, ou PostgreSQL com pgvector)
DATABASE_URL=sqlite+aiosqlite:///./omnisearch.db
# Para PostgreSQL com pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespw@localhost:5432/omnisearch_db

# Modelo SigLIP da Google DeepMind / Hugging Face
MODEL_NAME=google/siglip-base-patch16-384
EMBEDDING_DIM=768

# URL da API para o Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

